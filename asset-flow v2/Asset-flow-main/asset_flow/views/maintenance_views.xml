<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_flow_maintenance_list" model="ir.ui.view">
        <field name="name">asset.flow.maintenance.list</field>
        <field name="model">asset.flow.maintenance</field>
        <field name="arch" type="xml">
            <list string="Maintenance" decoration-danger="priority == 'critical'" decoration-warning="priority == 'high'">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="department_id"/>
                <field name="requested_by_id"/>
                <field name="assigned_to_id"/>
                <field name="maintenance_type"/>
                <field name="priority"/>
                <field name="state" widget="badge" decoration-info="state in ('pending', 'approved')" decoration-warning="state in ('assigned', 'in_progress')" decoration-success="state == 'resolved'"/>
                <field name="request_date"/>
            </list>
        </field>
    </record>

    <record id="view_asset_flow_maintenance_form" model="ir.ui.view">
        <field name="name">asset.flow.maintenance.form</field>
        <field name="model">asset.flow.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'pending'" groups="asset_flow.group_asset_flow_asset_manager"/>
                    <button name="action_assign" type="object" string="Assign Technician" class="btn-primary" invisible="state != 'approved'" groups="asset_flow.group_asset_flow_asset_manager"/>
                    <button name="action_start" type="object" string="Start Work" class="btn-warning" invisible="state != 'assigned'"/>
                    <button name="action_resolve" type="object" string="Resolve" class="btn-success" invisible="state != 'in_progress'" confirm="Mark this maintenance as resolved?"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('resolved', 'cancelled')" confirm="Cancel this maintenance request?"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,assigned,in_progress,resolved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="asset_id" readonly="state != 'pending'"/>
                            <field name="department_id"/>
                            <field name="requested_by_id" readonly="state != 'pending'"/>
                            <field name="assigned_to_id" readonly="state not in ('approved', 'assigned')"/>
                        </group>
                        <group>
                            <field name="maintenance_type" readonly="state != 'pending'"/>
                            <field name="priority"/>
                            <field name="request_date"/>
                            <field name="scheduled_date"/>
                            <field name="resolved_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Resolution">
                            <field name="resolution_notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_asset_flow_maintenance_kanban" model="ir.ui.view">
        <field name="name">asset.flow.maintenance.kanban</field>
        <field name="model">asset.flow.maintenance</field>
        <field name="arch" type="xml">
            <kanban string="Maintenance" default_group_by="state">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="priority"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div><field name="asset_id"/></div>
                            <div><field name="priority"/></div>
                            <div><field name="state" widget="badge"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_asset_flow_maintenance_search" model="ir.ui.view">
        <field name="name">asset.flow.maintenance.search</field>
        <field name="model">asset.flow.maintenance</field>
        <field name="arch" type="xml">
            <search string="Maintenance">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="department_id"/>
                <field name="requested_by_id"/>
                <field name="assigned_to_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="resolved" string="Resolved" domain="[('state', '=', 'resolved')]"/>
                <filter name="critical" string="Critical" domain="[('priority', '=', 'critical')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_asset" string="Asset" context="{'group_by': 'asset_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_flow_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">asset.flow.maintenance</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_asset_flow_maintenance_search"/>
    </record>
</odoo>
