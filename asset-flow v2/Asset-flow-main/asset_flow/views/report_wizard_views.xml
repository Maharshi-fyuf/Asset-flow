<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_flow_report_wizard_form" model="ir.ui.view">
        <field name="name">asset.flow.report.wizard.form</field>
        <field name="model">asset.flow.report.wizard</field>
        <field name="arch" type="xml">
            <form string="AssetFlow Reports">
                <sheet>
                    <group>
                        <group>
                            <field name="report_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="category_id"/>
                            <field name="employee_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_pdf" type="object" string="Generate PDF" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button name="action_generate_xlsx" type="object" string="Export XLSX" class="btn-success" icon="fa-file-excel-o"/>
                    <button name="action_generate_csv" type="object" string="Export CSV" class="btn-info" icon="fa-file-text-o"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_asset_flow_report_wizard" model="ir.actions.act_window">
        <field name="name">Reports</field>
        <field name="res_model">asset.flow.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
