<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_flow_employee_list" model="ir.ui.view">
        <field name="name">asset.flow.employee.list</field>
        <field name="model">asset.flow.employee</field>
        <field name="arch" type="xml">
            <list string="Employees">
                <field name="name"/>
                <field name="user_id"/>
                <field name="department_id"/>
                <field name="manager_id"/>
                <field name="work_email"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_asset_flow_employee_form" model="ir.ui.view">
        <field name="name">asset.flow.employee.form</field>
        <field name="model">asset.flow.employee</field>
        <field name="arch" type="xml">
            <form string="Employee">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="department_id"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="job_title"/>
                            <field name="work_email"/>
                            <field name="phone"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assigned Assets">
                            <field name="asset_ids"/>
                        </page>
                        <page string="Requests">
                            <field name="request_ids"/>
                        </page>
                        <page string="Bookings">
                            <field name="booking_ids"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_asset_flow_employee_kanban" model="ir.ui.view">
        <field name="name">asset.flow.employee.kanban</field>
        <field name="model">asset.flow.employee</field>
        <field name="arch" type="xml">
            <kanban string="Employees">
                <field name="name"/>
                <field name="department_id"/>
                <field name="job_title"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div><field name="job_title"/></div>
                            <div><field name="department_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_asset_flow_employee_search" model="ir.ui.view">
        <field name="name">asset.flow.employee.search</field>
        <field name="model">asset.flow.employee</field>
        <field name="arch" type="xml">
            <search string="Employees">
                <field name="name"/>
                <field name="user_id"/>
                <field name="department_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_flow_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">asset.flow.employee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_asset_flow_employee_search"/>
    </record>
</odoo>
