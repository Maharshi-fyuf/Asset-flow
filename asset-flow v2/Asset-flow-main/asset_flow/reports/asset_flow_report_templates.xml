<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Asset Utilization Report                                      -->
    <!-- ============================================================ -->
    <template id="report_asset_utilization_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Asset Utilization Report</h2>
                    <p t-if="data and data.get('date_from')">
                        <strong>Department:</strong> <t t-esc="data.get('department', 'All')"/>
                        | <strong>Category:</strong> <t t-esc="data.get('category', 'All')"/>
                    </p>
                    <table class="table table-sm table-striped mt-3">
                        <thead>
                            <tr>
                                <th>Asset Tag</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Department</th>
                                <th>Assigned To</th>
                                <th>Status</th>
                                <th>Location</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="asset">
                                <tr>
                                    <td><t t-esc="asset.asset_tag"/></td>
                                    <td><t t-esc="asset.name"/></td>
                                    <td><t t-esc="asset.category_id.complete_name"/></td>
                                    <td><t t-esc="asset.department_id.name"/></td>
                                    <td><t t-esc="asset.current_employee_id.name or '-'"/></td>
                                    <td><t t-esc="dict(asset._fields['state'].selection).get(asset.state, '')"/></td>
                                    <td><t t-esc="asset.location or '-'"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <p class="mt-2"><strong>Total Assets:</strong> <t t-esc="len(docs)"/></p>
                </div>
            </t>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Department Summary Report                                     -->
    <!-- ============================================================ -->
    <template id="report_department_summary_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Department Summary Report</h2>
                    <table class="table table-sm table-striped mt-3">
                        <thead>
                            <tr>
                                <th>Department</th>
                                <th>Code</th>
                                <th>Manager</th>
                                <th>Employees</th>
                                <th>Assets</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="dept">
                                <tr>
                                    <td><t t-esc="dept.name"/></td>
                                    <td><t t-esc="dept.code or '-'"/></td>
                                    <td><t t-esc="dept.manager_id.name or '-'"/></td>
                                    <td><t t-esc="dept.employee_count"/></td>
                                    <td><t t-esc="dept.asset_count"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Maintenance Report                                            -->
    <!-- ============================================================ -->
    <template id="report_maintenance_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Maintenance Report</h2>
                    <p t-if="data">
                        <strong>Period:</strong>
                        <t t-esc="data.get('date_from', 'N/A')"/> to <t t-esc="data.get('date_to', 'N/A')"/>
                        | <strong>Department:</strong> <t t-esc="data.get('department', 'All')"/>
                    </p>
                    <table class="table table-sm table-striped mt-3">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Asset</th>
                                <th>Type</th>
                                <th>Priority</th>
                                <th>Technician</th>
                                <th>Status</th>
                                <th>Request Date</th>
                                <th>Resolved Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="maint">
                                <tr>
                                    <td><t t-esc="maint.name"/></td>
                                    <td><t t-esc="maint.asset_id.name"/></td>
                                    <td><t t-esc="dict(maint._fields['maintenance_type'].selection).get(maint.maintenance_type, '')"/></td>
                                    <td><t t-esc="dict(maint._fields['priority'].selection).get(maint.priority, '')"/></td>
                                    <td><t t-esc="maint.assigned_to_id.name or '-'"/></td>
                                    <td><t t-esc="dict(maint._fields['state'].selection).get(maint.state, '')"/></td>
                                    <td><t t-esc="maint.request_date"/></td>
                                    <td><t t-esc="maint.resolved_date or '-'"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <p class="mt-2"><strong>Total Records:</strong> <t t-esc="len(docs)"/></p>
                </div>
            </t>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Audit Report                                                  -->
    <!-- ============================================================ -->
    <template id="report_audit_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Audit Report</h2>
                    <t t-foreach="docs" t-as="audit">
                        <h4 class="mt-3"><t t-esc="audit.name"/></h4>
                        <p>
                            <strong>Department:</strong> <t t-esc="audit.department_id.name or '-'"/>
                            | <strong>Auditor:</strong> <t t-esc="audit.auditor_id.name or '-'"/>
                            | <strong>Status:</strong> <t t-esc="dict(audit._fields['state'].selection).get(audit.state, '')"/>
                        </p>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Asset</th>
                                    <th>Expected Employee</th>
                                    <th>Actual Employee</th>
                                    <th>Condition</th>
                                    <th>Status</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="audit.line_ids" t-as="line">
                                    <tr>
                                        <td><t t-esc="line.asset_id.name"/></td>
                                        <td><t t-esc="line.expected_employee_id.name or '-'"/></td>
                                        <td><t t-esc="line.actual_employee_id.name or '-'"/></td>
                                        <td><t t-esc="dict(line._fields['condition'].selection).get(line.condition, '')"/></td>
                                        <td><t t-esc="dict(line._fields['status'].selection).get(line.status, '')"/></td>
                                        <td><t t-esc="line.notes or '-'"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Booking Report                                                -->
    <!-- ============================================================ -->
    <template id="report_booking_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Booking Report</h2>
                    <p t-if="data">
                        <strong>Period:</strong>
                        <t t-esc="data.get('date_from', 'N/A')"/> to <t t-esc="data.get('date_to', 'N/A')"/>
                        | <strong>Department:</strong> <t t-esc="data.get('department', 'All')"/>
                    </p>
                    <table class="table table-sm table-striped mt-3">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Resource</th>
                                <th>Booked By</th>
                                <th>Department</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Purpose</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="booking">
                                <tr>
                                    <td><t t-esc="booking.name"/></td>
                                    <td><t t-esc="booking.asset_id.name"/></td>
                                    <td><t t-esc="booking.employee_id.name"/></td>
                                    <td><t t-esc="booking.department_id.name or '-'"/></td>
                                    <td><t t-esc="booking.start_datetime"/></td>
                                    <td><t t-esc="booking.end_datetime"/></td>
                                    <td><t t-esc="booking.purpose or '-'"/></td>
                                    <td><t t-esc="dict(booking._fields['state'].selection).get(booking.state, '')"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <p class="mt-2"><strong>Total Bookings:</strong> <t t-esc="len(docs)"/></p>
                </div>
            </t>
        </t>
    </template>
</odoo>
