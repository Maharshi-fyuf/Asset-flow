<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_flow_asset_request_list" model="ir.ui.view">
        <field name="name">asset.flow.asset.request.list</field>
        <field name="model">asset.flow.asset.request</field>
        <field name="arch" type="xml">
            <list string="Asset Requests"
                  decoration-success="state == 'done'"
                  decoration-warning="state == 'submitted'"
                  decoration-danger="state in ('rejected', 'cancelled')"
                  decoration-info="state == 'approved'">
                <field name="name"/>
                <field name="request_type"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="category_id"/>
                <field name="asset_id"/>
                <field name="request_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_asset_flow_asset_request_form" model="ir.ui.view">
        <field name="name">asset.flow.asset.request.form</field>
        <field name="model">asset.flow.asset.request</field>
        <field name="arch" type="xml">
            <form string="Asset Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'"/>
                    <button name="action_done" string="Mark as Done" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="request_type"/>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="requested_by_user_id"/>
                        </group>
                        <group>
                            <field name="category_id"/>
                            <field name="asset_id"/>
                            <field name="request_date"/>
                            <field name="needed_by_date"/>
                            <field name="expected_return_date"/>
                        </group>

                    </group>
                    <notebook>
                        <page string="Assignment History">
                            <field name="assignment_history_ids"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_asset_flow_asset_request_kanban" model="ir.ui.view">
        <field name="name">asset.flow.asset.request.kanban</field>
        <field name="model">asset.flow.asset.request</field>
        <field name="arch" type="xml">
            <kanban string="Asset Requests" default_group_by="state"
                    group_create="false" quick_create="false">
                <field name="name"/>
                <field name="request_type"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="asset_id"/>
                <field name="needed_by_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <t t-set="border_color"
                           t-value="{'draft':      '#6b7280',
                                     'submitted':  '#f59e0b',
                                     'approved':   '#3b82f6',
                                     'done':       '#10b981',
                                     'rejected':   '#ef4444',
                                     'cancelled':  '#ef4444'}.get(record.state.raw_value, '#6b7280')"/>
                        <div t-attf-style="border-left: 4px solid #{border_color}; padding: 8px 12px;"
                             class="oe_kanban_global_click o_kanban_record">
                            <!-- Reference + state badge -->
                            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:4px;">
                                <strong style="font-size:0.8rem; word-break:break-all;">
                                    <field name="name"/>
                                </strong>
                                <span t-attf-style="font-size:0.7rem; font-weight:600; padding:2px 6px;
                                                   border-radius:10px; white-space:nowrap;
                                                   background:#{border_color}22;
                                                   color:#{border_color};">
                                    <field name="state"/>
                                </span>
                            </div>
                            <!-- Request type -->
                            <div style="font-size:0.8rem; margin-top:4px;">
                                <i class="fa fa-exchange" style="margin-right:4px;"/>
                                <field name="request_type"/>
                            </div>
                            <!-- Requested for employee -->
                            <t t-if="record.employee_id.value">
                                <div style="font-size:0.8rem; color:#6b7280; margin-top:2px;">
                                    <i class="fa fa-user" style="margin-right:4px;"/>
                                    <field name="employee_id"/>
                                </div>
                            </t>
                            <!-- Department -->
                            <t t-if="record.department_id.value">
                                <div style="font-size:0.8rem; color:#6b7280; margin-top:2px;">
                                    <i class="fa fa-building" style="margin-right:4px;"/>
                                    <field name="department_id"/>
                                </div>
                            </t>
                            <!-- Asset assigned -->
                            <t t-if="record.asset_id.value">
                                <div style="font-size:0.75rem; color:#9ca3af; margin-top:4px;">
                                    <i class="fa fa-cube" style="margin-right:4px;"/>
                                    <field name="asset_id"/>
                                </div>
                            </t>
                            <!-- Needed by date -->
                            <t t-if="record.needed_by_date.value">
                                <div style="font-size:0.75rem; color:#9ca3af; margin-top:2px;">
                                    <i class="fa fa-calendar" style="margin-right:4px;"/>
                                    Needed by: <field name="needed_by_date"/>
                                </div>
                            </t>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_asset_flow_asset_request_search" model="ir.ui.view">
        <field name="name">asset.flow.asset.request.search</field>
        <field name="model">asset.flow.asset.request</field>
        <field name="arch" type="xml">
            <search string="Asset Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="category_id"/>
                <field name="asset_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Request Type" context="{'group_by': 'request_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_flow_asset_request" model="ir.actions.act_window">
        <field name="name">Asset Requests</field>
        <field name="res_model">asset.flow.asset.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_asset_flow_asset_request_search"/>
    </record>
</odoo>
