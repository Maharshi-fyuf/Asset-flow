<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_flow_asset_list" model="ir.ui.view">
        <field name="name">asset.flow.asset.list</field>
        <field name="model">asset.flow.asset</field>
        <field name="arch" type="xml">
            <list string="Assets"
                  decoration-success="state == 'available'"
                  decoration-warning="state in ('maintenance', 'reserved')"
                  decoration-danger="state in ('lost', 'retired', 'disposed')"
                  decoration-muted="state == 'allocated'">
                <field name="asset_tag"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="department_id"/>
                <field name="current_employee_id"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'available'"
                    decoration-info="state == 'allocated'"
                    decoration-warning="state in ('maintenance', 'reserved')"
                    decoration-danger="state in ('lost', 'retired', 'disposed')"/>
                <field name="location"/>
            </list>
        </field>
    </record>

    <record id="view_asset_flow_asset_form" model="ir.ui.view">
        <field name="name">asset.flow.asset.form</field>
        <field name="model">asset.flow.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <sheet>
                    <group>
                        <group>
                            <field name="asset_tag"/>
                            <field name="name"/>
                            <field name="serial_number"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="condition"/>
                            <field name="is_shared"/>
                            <field name="department_id"/>
                            <field name="current_employee_id"/>
                            <field name="location"/>
                        </group>
                    </group>
                    <group>
                        <field name="purchase_date"/>
                        <field name="purchase_value"/>
                        <field name="currency_id"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Requests">
                            <field name="request_ids"/>
                        </page>
                        <page string="Bookings">
                            <field name="booking_ids"/>
                        </page>
                        <page string="Maintenance">
                            <field name="maintenance_ids"/>
                        </page>
                        <page string="Assignment History">
                            <field name="assignment_history_ids"/>
                        </page>
                        <page string="Audit Lines">
                            <field name="audit_line_ids"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_asset_flow_asset_kanban" model="ir.ui.view">
        <field name="name">asset.flow.asset.kanban</field>
        <field name="model">asset.flow.asset</field>
        <field name="arch" type="xml">
            <kanban string="Assets" default_group_by="state"
                    group_create="false" quick_create="false">
                <field name="asset_tag"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="department_id"/>
                <field name="current_employee_id"/>
                <field name="location"/>
                <field name="condition"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <!-- Determine left-border color by state -->
                        <t t-set="border_color"
                           t-value="{'available': '#10b981',
                                     'allocated': '#3b82f6',
                                     'reserved':  '#8b5cf6',
                                     'maintenance': '#f59e0b',
                                     'lost':     '#ef4444',
                                     'retired':  '#ef4444',
                                     'disposed': '#6b7280'}.get(record.state.raw_value, '#6b7280')"/>
                        <div t-attf-style="border-left: 4px solid #{border_color}; padding: 8px 12px;"
                             class="oe_kanban_global_click o_kanban_record">
                            <!-- Header row: tag + state badge -->
                            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:4px;">
                                <strong style="font-size:0.85rem; word-break:break-all;">
                                    <field name="asset_tag"/>
                                </strong>
                                <span t-attf-style="font-size:0.7rem; font-weight:600; padding:2px 6px;
                                                   border-radius:10px; white-space:nowrap;
                                                   background:#{border_color}22;
                                                   color:#{border_color};">
                                    <field name="state"/>
                                </span>
                            </div>
                            <!-- Asset name -->
                            <div style="font-weight:600; margin-top:4px;">
                                <field name="name"/>
                            </div>
                            <!-- Category -->
                            <div style="font-size:0.8rem; color:#6b7280; margin-top:4px;">
                                <i class="fa fa-tag" style="margin-right:4px;"/>
                                <field name="category_id"/>
                            </div>
                            <!-- Department / Employee -->
                            <t t-if="record.current_employee_id.value">
                                <div style="font-size:0.8rem; color:#6b7280; margin-top:2px;">
                                    <i class="fa fa-user" style="margin-right:4px;"/>
                                    <field name="current_employee_id"/>
                                </div>
                            </t>
                            <t t-elif="record.department_id.value">
                                <div style="font-size:0.8rem; color:#6b7280; margin-top:2px;">
                                    <i class="fa fa-building" style="margin-right:4px;"/>
                                    <field name="department_id"/>
                                </div>
                            </t>
                            <!-- Location -->
                            <t t-if="record.location.value">
                                <div style="font-size:0.75rem; color:#9ca3af; margin-top:4px;">
                                    <i class="fa fa-map-marker" style="margin-right:4px;"/>
                                    <field name="location"/>
                                </div>
                            </t>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_asset_flow_asset_search" model="ir.ui.view">
        <field name="name">asset.flow.asset.search</field>
        <field name="model">asset.flow.asset</field>
        <field name="arch" type="xml">
            <search string="Assets">
                <field name="name"/>
                <field name="asset_tag"/>
                <field name="serial_number"/>
                <field name="category_id"/>
                <field name="department_id"/>
                <field name="current_employee_id"/>
                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="allocated" string="Allocated" domain="[('state', '=', 'allocated')]"/>
                <filter name="maintenance" string="Under Maintenance" domain="[('state', '=', 'maintenance')]"/>
                <filter name="retired" string="Retired" domain="[('state', '=', 'retired')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_flow_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">asset.flow.asset</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_asset_flow_asset_search"/>
    </record>
</odoo>
