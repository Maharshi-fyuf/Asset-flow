<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_flow_assignment_history_list" model="ir.ui.view">
        <field name="name">asset.flow.assignment.history.list</field>
        <field name="model">asset.flow.assignment.history</field>
        <field name="arch" type="xml">
            <list string="Assignment History">
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="request_id"/>
                <field name="assigned_date"/>
                <field name="returned_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_asset_flow_assignment_history_form" model="ir.ui.view">
        <field name="name">asset.flow.assignment.history.form</field>
        <field name="model">asset.flow.assignment.history</field>
        <field name="arch" type="xml">
            <form string="Assignment History">
                <sheet>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="request_id"/>
                        </group>
                        <group>
                            <field name="assigned_by_user_id"/>
                            <field name="assigned_date"/>
                            <field name="returned_date"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_asset_flow_assignment_history_kanban" model="ir.ui.view">
        <field name="name">asset.flow.assignment.history.kanban</field>
        <field name="model">asset.flow.assignment.history</field>
        <field name="arch" type="xml">
            <kanban string="Assignment History" default_group_by="state">
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="asset_id"/></strong>
                            <div><field name="employee_id"/></div>
                            <div><field name="state"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_asset_flow_assignment_history_search" model="ir.ui.view">
        <field name="name">asset.flow.assignment.history.search</field>
        <field name="model">asset.flow.assignment.history</field>
        <field name="arch" type="xml">
            <search string="Assignment History">
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="request_id"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="returned" string="Returned" domain="[('state', '=', 'returned')]"/>
                <filter name="transferred" string="Transferred" domain="[('state', '=', 'transferred')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_asset" string="Asset" context="{'group_by': 'asset_id'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_flow_assignment_history" model="ir.actions.act_window">
        <field name="name">Assignment History</field>
        <field name="res_model">asset.flow.assignment.history</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_asset_flow_assignment_history_search"/>
    </record>
</odoo>
