<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_flow_resource_booking_list" model="ir.ui.view">
        <field name="name">asset.flow.resource.booking.list</field>
        <field name="model">asset.flow.resource.booking</field>
        <field name="arch" type="xml">
            <list string="Resource Bookings">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_asset_flow_resource_booking_form" model="ir.ui.view">
        <field name="name">asset.flow.resource.booking.form</field>
        <field name="model">asset.flow.resource.booking</field>
        <field name="arch" type="xml">
            <form string="Resource Booking">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="asset_id"/>
                            <field name="category_id"/>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="state"/>
                            <field name="purpose"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_asset_flow_resource_booking_kanban" model="ir.ui.view">
        <field name="name">asset.flow.resource.booking.kanban</field>
        <field name="model">asset.flow.resource.booking</field>
        <field name="arch" type="xml">
            <kanban string="Resource Bookings" default_group_by="state">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div><field name="asset_id"/></div>
                            <div><field name="employee_id"/></div>
                            <div><field name="state"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_asset_flow_resource_booking_search" model="ir.ui.view">
        <field name="name">asset.flow.resource.booking.search</field>
        <field name="model">asset.flow.resource.booking</field>
        <field name="arch" type="xml">
            <search string="Resource Bookings">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="start_datetime"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_resource" string="Resource" context="{'group_by': 'asset_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_flow_resource_booking" model="ir.actions.act_window">
        <field name="name">Resource Bookings</field>
        <field name="res_model">asset.flow.resource.booking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_asset_flow_resource_booking_search"/>
    </record>
</odoo>
