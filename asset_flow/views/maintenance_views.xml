<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_flow_maintenance_list" model="ir.ui.view">
        <field name="name">asset.flow.maintenance.list</field>
        <field name="model">asset.flow.maintenance</field>
        <field name="arch" type="xml">
            <list string="Maintenance"
                  decoration-success="state == 'resolved'"
                  decoration-warning="state == 'in_progress'"
                  decoration-danger="priority == 'critical' and state not in ('resolved', 'cancelled')"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="department_id"/>
                <field name="requested_by_id"/>
                <field name="assigned_to_id"/>
                <field name="maintenance_type"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="request_date"/>
            </list>
        </field>
    </record>

    <record id="view_asset_flow_maintenance_form" model="ir.ui.view">
        <field name="name">asset.flow.maintenance.form</field>
        <field name="model">asset.flow.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'pending'"/>
                    <button name="action_assign" string="Assign Technician" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_in_progress" string="Start Work" type="object" class="oe_highlight" invisible="state != 'assigned'"/>
                    <button name="action_resolve" string="Resolve" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('resolved', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,assigned,in_progress,resolved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="asset_id"/>
                            <field name="department_id"/>
                            <field name="requested_by_id"/>
                            <field name="assigned_to_id"/>
                        </group>
                        <group>
                            <field name="maintenance_type"/>
                            <field name="priority"/>
                            <field name="request_date"/>
                            <field name="scheduled_date"/>
                            <field name="resolved_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Resolution">
                            <field name="resolution_notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_asset_flow_maintenance_kanban" model="ir.ui.view">
        <field name="name">asset.flow.maintenance.kanban</field>
        <field name="model">asset.flow.maintenance</field>
        <field name="arch" type="xml">
            <kanban string="Maintenance" default_group_by="state"
                    group_create="false" quick_create="false">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="assigned_to_id"/>
                <field name="department_id"/>
                <field name="maintenance_type"/>
                <field name="priority"/>
                <field name="request_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <t t-set="border_color"
                           t-value="{'pending':    '#f59e0b',
                                     'approved':   '#3b82f6',
                                     'assigned':   '#8b5cf6',
                                     'in_progress':'#f97316',
                                     'resolved':   '#10b981',
                                     'cancelled':  '#6b7280'}.get(record.state.raw_value, '#6b7280')"/>
                        <t t-set="priority_color"
                           t-value="{'critical': '#ef4444', 'high': '#f97316',
                                     'normal': '#6b7280', 'low': '#9ca3af'}.get(record.priority.raw_value, '#6b7280')"/>
                        <div t-attf-style="border-left: 4px solid #{border_color}; padding: 8px 12px;"
                             class="oe_kanban_global_click o_kanban_record">
                            <!-- Reference + state badge -->
                            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:4px;">
                                <strong style="font-size:0.8rem; word-break:break-all;">
                                    <field name="name"/>
                                </strong>
                                <span t-attf-style="font-size:0.7rem; font-weight:600; padding:2px 6px;
                                                   border-radius:10px; white-space:nowrap;
                                                   background:#{border_color}22;
                                                   color:#{border_color};">
                                    <field name="state"/>
                                </span>
                            </div>
                            <!-- Asset -->
                            <div style="font-size:0.85rem; font-weight:600; margin-top:6px;">
                                <i class="fa fa-cube" style="margin-right:4px;"/>
                                <field name="asset_id"/>
                            </div>
                            <!-- Maintenance type -->
                            <div style="font-size:0.8rem; color:#6b7280; margin-top:4px;">
                                <i class="fa fa-wrench" style="margin-right:4px;"/>
                                <field name="maintenance_type"/>
                            </div>
                            <!-- Priority indicator -->
                            <div style="margin-top:6px; display:flex; align-items:center; gap:6px;">
                                <span t-attf-style="font-size:0.7rem; font-weight:700; padding:2px 8px;
                                                   border-radius:10px;
                                                   background:#{priority_color}22;
                                                   color:#{priority_color};">
                                    <field name="priority"/>
                                </span>
                            </div>
                            <!-- Technician -->
                            <t t-if="record.assigned_to_id.value">
                                <div style="font-size:0.75rem; color:#9ca3af; margin-top:4px;">
                                    <i class="fa fa-user-circle" style="margin-right:4px;"/>
                                    <field name="assigned_to_id"/>
                                </div>
                            </t>
                            <!-- Department -->
                            <t t-if="record.department_id.value">
                                <div style="font-size:0.75rem; color:#9ca3af; margin-top:2px;">
                                    <i class="fa fa-building" style="margin-right:4px;"/>
                                    <field name="department_id"/>
                                </div>
                            </t>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_asset_flow_maintenance_search" model="ir.ui.view">
        <field name="name">asset.flow.maintenance.search</field>
        <field name="model">asset.flow.maintenance</field>
        <field name="arch" type="xml">
            <search string="Maintenance">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="department_id"/>
                <field name="requested_by_id"/>
                <field name="assigned_to_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="resolved" string="Resolved" domain="[('state', '=', 'resolved')]"/>
                <filter name="critical" string="Critical" domain="[('priority', '=', 'critical')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_asset" string="Asset" context="{'group_by': 'asset_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_flow_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">asset.flow.maintenance</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_asset_flow_maintenance_search"/>
    </record>
</odoo>
