<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_flow_asset_category_list" model="ir.ui.view">
        <field name="name">asset.flow.asset.category.list</field>
        <field name="model">asset.flow.asset.category</field>
        <field name="arch" type="xml">
            <list string="Asset Categories">
                <field name="complete_name"/>
                <field name="code"/>
                <field name="category_type"/>
                <field name="maintenance_required"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_asset_flow_asset_category_form" model="ir.ui.view">
        <field name="name">asset.flow.asset.category.form</field>
        <field name="model">asset.flow.asset.category</field>
        <field name="arch" type="xml">
            <form string="Asset Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="parent_id"/>
                            <field name="category_type"/>
                        </group>
                        <group>
                            <field name="maintenance_required"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Child Categories">
                            <field name="child_ids"/>
                        </page>
                        <page string="Assets">
                            <field name="asset_ids"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_asset_flow_asset_category_kanban" model="ir.ui.view">
        <field name="name">asset.flow.asset.category.kanban</field>
        <field name="model">asset.flow.asset.category</field>
        <field name="arch" type="xml">
            <kanban string="Asset Categories">
                <field name="complete_name"/>
                <field name="category_type"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="complete_name"/></strong>
                            <div><field name="category_type"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_asset_flow_asset_category_search" model="ir.ui.view">
        <field name="name">asset.flow.asset.category.search</field>
        <field name="model">asset.flow.asset.category</field>
        <field name="arch" type="xml">
            <search string="Asset Categories">
                <field name="name"/>
                <field name="complete_name"/>
                <field name="code"/>
                <field name="category_type"/>
                <filter name="asset" string="Assets" domain="[('category_type', 'in', ['asset', 'both'])]"/>
                <filter name="resource" string="Resources" domain="[('category_type', 'in', ['resource', 'both'])]"/>
                <filter name="maintenance_required" string="Maintenance Required" domain="[('maintenance_required', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_asset_flow_asset_category" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">asset.flow.asset.category</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_asset_flow_asset_category_search"/>
    </record>
</odoo>
